{
  "schemaVersion": 1,
  "name": "dtc-delivery",
  "version": "1.1.0",
  "description": "从当前源码生成可交付候选，核对构建身份、授权范围、目标环境漂移、写入/回读和发布交接；适用于任意应用或部署平台。",
  "stage": "release",
  "inputs": [
    "context",
    "implementation diff",
    "build manifest",
    "authorized paths",
    "target snapshot"
  ],
  "outputs": [
    "candidate",
    "delivery plan",
    "write/readback receipt",
    "handoff status"
  ],
  "privacy": "候选清单和回执不包含凭据、客户数据或签名 URL",
  "entrypoint": "SKILL.md",
  "$schema": "../../schemas/skill.schema.json",
  "relatedSkills": [
    "dtc-ci-monitor",
    "dtc-context",
    "dtc-evidence-log",
    "dtc-implementation",
    "dtc-scoped-validation"
  ]
}
