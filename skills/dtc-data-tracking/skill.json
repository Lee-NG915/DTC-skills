    "tracking contract",
    "scenario scope",
    "unit/browser results",
    "downstream acceptance gaps"
  ],
  "privacy": "事件 payload 只使用合成或最小字段，不记录个人身份",
  "entrypoint": "SKILL.md",
  "$schema": "../../schemas/skill.schema.json",
  "relatedSkills": [
    "dtc-context",
    "dtc-implementation",
    "dtc-scoped-validation"
  ]
}
