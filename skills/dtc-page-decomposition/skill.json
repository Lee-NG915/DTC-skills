    "region map",
    "composition decisions",
    "page state matrix",
    "handoff notes"
  ],
  "relatedSkills": [
    "dtc-context",
    "dtc-requirements-analysis",
    "dtc-design-evidence",
    "dtc-atomic-decomposition",
    "dtc-technical-design"
  ],
  "privacy": "公开输出仅使用脱敏设计、合成数据和占位符",
  "entrypoint": "SKILL.md"
}
