{
  "schemaVersion": 1,
  "name": "dtc-evidence-log",
  "version": "1.1.0",
  "description": "用一份持续维护的记录串联需求、设计、实现、验证、交付和复盘，保留候选身份、失败闭环及证据取回方式。",
  "stage": "record",
  "inputs": [
    "context",
    "stage outputs",
    "commands and results",
    "artifacts"
  ],
  "outputs": [
    "timeline",
    "evidence manifest",
    "handoff summary",
    "open issues"
  ],
  "privacy": "只归档脱敏摘要和最小证据索引，原始敏感输出留在受控位置",
  "entrypoint": "SKILL.md",
  "$schema": "../../schemas/skill.schema.json",
  "relatedSkills": [
    "dtc-context",
    "dtc-privacy-redaction",
    "dtc-recording-analysis"
  ]
}
