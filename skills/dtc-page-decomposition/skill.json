{
  "$schema": "../../schemas/skill.schema.json",
  "schemaVersion": 1,
  "name": "dtc-page-decomposition",
  "version": "1.0.0",
  "description": "把 Figma 页面或产品页面拆成页面区域、组合组件、页面级状态和数据边界，输出可实现的页面组件树，适用于任意前端技术栈。",
  "stage": "architecture",
